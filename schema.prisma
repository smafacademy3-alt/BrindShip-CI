// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Définition des Rôles (L'élément central des différents Dashboards)
enum Role {
  ADMIN
  MERCHANT
  INFLUENCER
  DRIVER
  BUYER
}

enum OrderStatus {
  PENDING           // En attente de validation
  PREPARING         // Accepté par le marchand
  READY_FOR_PICKUP  // Prêt pour le livreur
  IN_TRANSIT        // En cours de livraison
  DELIVERED         // Livré (déclenche les paiements)
  CANCELLED         // Annulé
}

// 2. Modèle Utilisateur Global
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role      @default(BUYER)
  phone         String?
  
  // Portefeuille virtuel (Crucial pour les gains Influenceurs et Marchands)
  walletBalance Float     @default(0.0) 

  // Relations
  store         Store?    // Si l'utilisateur est un MARCHAND
  promoCodes    PromoCode[] // Si l'utilisateur est un INFLUENCEUR
  deliveries    Order[]   @relation("DriverOrders")
  purchases     Order[]   @relation("BuyerOrders")
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// 3. Boutique du Marchand
model Store {
  id          String    @id @default(cuid())
  name        String
  description String?
  merchantId  String    @unique
  merchant    User      @relation(fields: [merchantId], references: [id])
  products    Product[]
  orders      Order[]
}

// 4. Catalogue Produits
model Product {
  id          String    @id @default(cuid())
  name        String
  price       Float
  stock       Int       @default(0)
  imageUrl    String?
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  items       OrderItem[]
}

// 5. Codes Promo & Parrainage (Outils Publicitaires)
model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique // ex: INFLUENCEUR225
  influencerId  String
  influencer    User      @relation(fields: [influencerId], references: [id])
  
  // Règles métier BrandShip
  discountRate  Float     @default(0.0) // Réduction pour l'acheteur (ex: 5%)
  rewardAmount  Float     @default(200.0) // Prime parrainage fixe ligne 1 (200 Fcfa)
  
  orders        Order[]
}

// 6. Les Commandes (Le coeur du système)
model Order {
  id            String      @id @default(cuid())
  status        OrderStatus @default(PENDING)
  
  // Acteurs impliqués
  buyerId       String
  buyer         User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  storeId       String
  store         Store       @relation(fields: [storeId], references: [id])
  driverId      String?
  driver        User?       @relation("DriverOrders", fields: [driverId], references: [id])
  
  // Influenceur impliqué (Optionnel)
  promoCodeId   String?
  promoCode     PromoCode?  @relation(fields: [promoCodeId], references: [id])

  // Lignes de commande
  items         OrderItem[]
  
  // Données Financières (Tracabilité stricte)
  totalAmount   Float       // Montant payé par le client
  brandshipFee  Float       // Les 2% de commission plateforme
  influencerFee Float       @default(0.0) // Les 200 Fcfa (si code promo utilisé)
  netToMerchant Float       // Ce qui revient au vendeur
  
  deliveryAddress String
  createdAt     DateTime    @default(now())
}

// Lignes de commande (Panier)
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  priceAt   Float   // Prix bloqué au moment de l'achat
}
